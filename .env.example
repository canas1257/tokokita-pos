# =====================================================
# TOKOKITA POS - CONTOH ENVIRONMENT VARIABLES
# Jangan isi secret asli lalu commit file .env ke Git.
# =====================================================

# --------------------- BACKEND -----------------------
# Gunakan connection string dari PostgreSQL Railway.
DATABASE_URL="postgresql://postgres:password@localhost:5432/kasir?schema=public"

# Buat secret acak minimal 32 karakter untuk production.
JWT_SECRET="ganti-dengan-random-secret-minimal-32-karakter"

# Railway menyediakan PORT secara otomatis.
PORT=3000

# URL frontend yang diizinkan mengakses API.
# Beberapa origin dapat dipisahkan dengan koma.
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"

# Opsional: hanya dipakai ketika menjalankan npm run seed.
SEED_ADMIN_PASSWORD="Admin123!"
SEED_CASHIER_PASSWORD="Kasir123!"

# --------------------- FRONTEND ----------------------
# URL publik backend dengan akhiran /api.
VITE_API_URL="http://localhost:3000/api"

# URL publik backend tanpa /api untuk Socket.IO.
VITE_WS_URL="http://localhost:3000"
